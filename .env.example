# The mock mode is the safe local default. It requires no credentials.
RIGHTSRADAR_MODE=mock

# In hybrid mode, set each integration to mock or real independently.
# RIGHTSRADAR_MODE=hybrid
# RIGHTSRADAR_GEMINI_MODE=real
# RIGHTSRADAR_PARALLEL_MODE=real
# RIGHTSRADAR_REPOSITORY_MODE=real

# Cloud mode enables real Gemini on Vertex AI, Parallel Search, Firestore, and Cloud Storage.
# RIGHTSRADAR_MODE=cloud
# RIGHTSRADAR_GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
RIGHTSRADAR_GOOGLE_CLOUD_LOCATION=global
RIGHTSRADAR_GEMINI_MODEL=gemini-2.5-flash
# RIGHTSRADAR_PARALLEL_API_KEY=set-in-your-local-environment
RIGHTSRADAR_FIRESTORE_COLLECTION=rightsrader_cases
# RIGHTSRADAR_CLOUD_STORAGE_BUCKET=your-cloud-storage-bucket

# A real smoke run remains disabled unless both this flag and a non-mock mode are set.
RIGHTSRADAR_ENABLE_REAL_SMOKE=false

# Exposed to the browser; do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public Cloud Run URL for the RightsRadar API, inlined into the browser bundle at build time.
# NEXT_PUBLIC_* values are not secrets. An explicit environment variable (CI, Vercel dashboard,
# or Playwright) still wins over this file, so local and e2e runs keep using 127.0.0.1:8000.
NEXT_PUBLIC_API_BASE_URL=https://rightsrader-api-56763386386.us-central1.run.app
